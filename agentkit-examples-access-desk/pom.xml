<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.agentkit</groupId>
        <artifactId>agentkit-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agentkit-examples-access-desk</artifactId>
    <name>AgentKit Example — Access Desk</name>
    <description>Just-in-time access as an agent on the agent host: Acme's repository of agents
        (orgs/acme) and two MCP connectors — the company systems, and the access ledger that holds
        the desk's rules. People ask for access in plain language, a policy decides who approves, and
        every grant ends on its own.</description>

    <properties>
        <maven.deploy.skip>true</maven.deploy.skip>
        <exec.mainClass>dev.agentkit.accessdesk.ledger.AccessLedgerConnector</exec.mainClass>
        <exec.plugin.version>3.5.0</exec.plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.agentkit</groupId>
            <artifactId>agentkit-core</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.agentkit</groupId>
            <artifactId>agentkit-mcp</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.agentkit</groupId>
            <artifactId>agentkit-chat</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.agentkit</groupId>
            <artifactId>agentkit-llm-openrouter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>dev.agentkit</groupId>
            <artifactId>agentkit-eval</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.agentkit</groupId>
            <artifactId>agentkit-host</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
                <configuration>
                    <executable>java</executable>
                    <classpathScope>runtime</classpathScope>
                    <arguments>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>${exec.mainClass}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
