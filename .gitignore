# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*

# Maven
target/
!.mvn/wrapper/maven-wrapper.jar
.mvn/timing.properties

# IDEs
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath

# OS
.DS_Store

# Anything at the root whose name starts with a dot is local (.env, editor and tool state)
# — except the ones the project itself keeps. A new root dot-entry the project needs must be
# added to this list, or files inside it are silently never added.
/.*
!/.gitignore
!/.editorconfig
!/.github/
!/.mvn/
