<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.agentkit</groupId>
        <artifactId>agentkit-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agentkit-examples-workbench</artifactId>
    <name>AgentKit Example — The Agent's Workbench</name>
    <description>The workbench as the interface through which a human IT agent works real tickets: a
        live Jira connection, "what would the agent do?" rehearsals, supervised execution with
        human approval, mid-run questions that become durable customer knowledge, bulk triage,
        and per-category progressive automation.</description>

    <properties>
        <!-- A demo, not a published library. -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <exec.mainClass>dev.agentkit.workbench.WorkbenchApp</exec.mainClass>
        <exec.plugin.version>3.5.0</exec.plugin.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>dev.agentkit</groupId>
            <artifactId>agentkit-core</artifactId>
        </dependency>
        <!-- Triage verdicts are single-shot structured calls parsed into a Java record. -->
        <dependency>
            <groupId>dev.agentkit</groupId>
            <artifactId>agentkit-json</artifactId>
        </dependency>
        <!-- Optional at runtime: set WORKBENCH_LLM=anthropic plus ANTHROPIC_API_KEY. Reached
             reflectively, so the module boots without either jar's key configured. -->
        <dependency>
            <groupId>dev.agentkit</groupId>
            <artifactId>agentkit-llm-anthropic</artifactId>
        </dependency>
        <!-- The same through OpenRouter: WORKBENCH_LLM=openrouter plus OPENROUTER_API_KEY and an
             explicit WORKBENCH_MODEL. -->
        <dependency>
            <groupId>dev.agentkit</groupId>
            <artifactId>agentkit-llm-openrouter</artifactId>
        </dependency>
        <!-- The HTTP layer is the JDK's com.sun.net.httpserver and java.net.http; Jackson
             parses Jira's JSON and renders the payloads the single-page console consumes. -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-simple</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Test scope: the eval suite scores this agent against a real model when one is
             configured, and skips when one is not. Not a runtime dependency of the demo. -->
        <dependency>
            <groupId>dev.agentkit</groupId>
            <artifactId>agentkit-eval</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
                <configuration>
                    <executable>java</executable>
                    <classpathScope>runtime</classpathScope>
                    <arguments>
                        <argument>-classpath</argument>
                        <classpath/>
                        <argument>${exec.mainClass}</argument>
                    </arguments>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
